function buildNodeText(rawValue) {
    if (rawValue == null || rawValue === "") {
        return "";
    }

    return rawValue
        .split(",")
        .map(function (s) { return s.trim(); })
        .filter(function (s) { return s !== ""; })
        .join("\n");
}

function renderNodeTextarea(containerSelector, rowId, labelText, textareaId, rawValue) {
    var nodeText = buildNodeText(rawValue);

    $("#" + rowId).remove();

    var $container = $(containerSelector);

    var $row = $("<div>", {
        id: rowId,
        class: "row",
        style: "margin-top:10px; margin-bottom:10px;"
    });

    var $label = $("<p>", {
        class: "col-sm-3",
        text: labelText
    });

    var $textarea = $("<textarea>", {
        id: textareaId,
        class: "col-md-3",
    }).css({
        width: "40%",       
        height: nodeText ? "300px" : "120px",
        padding: "8px",
        resize: "vertical"
    });

    $textarea.val(nodeText);
    $row.append($label);
    $row.append($textarea);
    $container.append($row);
}


