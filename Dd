function addNodeToTextarea(inputSelector, textareaSelector) {
    var value = $(inputSelector).val().trim();
    if (value === "") return;

    var $textarea = $(textareaSelector);

    var current = $textarea.val()
        ? $textarea.val().split("\n").map(function(s) { return s.trim(); })
        : [];

    current = current.filter(function(s) {
        return s !== "";
    });

    if (current.includes(value)) {
        alert("Duplicate value");
        return;
    }

    current.push(value);

    $textarea.val(current.join("\n"));
    $(inputSelector).val("");
}
